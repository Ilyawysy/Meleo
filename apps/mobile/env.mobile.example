# Meleo Mobile App Environment Configuration
# Copy this file to .env.mobile and fill in your values
# Use with: flutter run --dart-define-from-file=.env.mobile

# Backend API URL
# For Android emulator: http://10.0.2.2:8001
# For iOS simulator: http://localhost:8001
# For physical device: http://YOUR_COMPUTER_IP:8001
API_BASE_URL=http://10.0.2.2:8001

# Supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Authentication
# JWT tokens are managed automatically by the app
# No manual configuration needed for authentication

# Sentry Error Tracking
# Two separate Sentry projects: mobile-dev + mobile-prod
# Get DSN from: https://sentry.io/settings/<your-org>/projects/<project>/keys/

# DEV project DSN (for staging/test builds)
SENTRY_DSN_DEV=https://examplePublicKey@o0000000.ingest.sentry.io/0000000

# PROD project DSN (for production builds)
SENTRY_DSN_PROD=https://examplePublicKey@o0000000.ingest.sentry.io/0000000

# Environment: dev or prod
# - dev: uses SENTRY_DSN_DEV, full APM sampling, detailed breadcrumbs
# - prod: uses SENTRY_DSN_PROD, low APM sampling (1%), minimal breadcrumbs
ENVIRONMENT=dev

# PostHog Product Analytics
# Get credentials from: https://us.i.posthog.com/settings/project
# API Key format: phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
POSTHOG_API_KEY=phc_YOUR_PROJECT_API_KEY
POSTHOG_HOST=https://us.i.posthog.com
