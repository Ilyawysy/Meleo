# Backend environment template. Copy to .env and fill with real values.
# Source: backend/infrastructure/config.py

# Environment
ENV=dev
LOG_LEVEL=DEBUG

# Database (Postgres, e.g. Supabase)
# Direct connection (port 5432) — each app connection = 1 Postgres connection
# Pooler connection (port 6543) — multiplexed via Supavisor, higher connection limits
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname
# For Supabase SSL: path to CA cert (e.g. infra/certs/prod-ca-2021.crt; absolute or repo-relative)
# PG_SSLROOTCERT=infra/certs/prod-ca-2021.crt
DB_POOL_SIZE=15
DB_MAX_OVERFLOW=15
DB_LOG_QUERIES=false
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE=300

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# HTTP
REQUEST_TIMEOUT_S=30

# Redis Coordination (noeviction — rate limit, semaphore)
REDIS_COORDINATION_HOST=localhost
REDIS_COORDINATION_PORT=6380

# Redis Cache (allkeys-lru — ETag, cursor)
REDIS_CACHE_HOST=localhost
REDIS_CACHE_PORT=6381

# Sync cursor HMAC signing (MUST change in production!)
CURSOR_SECRET=change-me-in-production

# Agent (LLM, OpenRouter)
AGENT_MODEL=
BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
BACKEND_API_URL=http://127.0.0.1:8001
SERVICE_TOKEN=
AGENT_TOOL_TIMEOUT_S=60

# PostHog (admin analytics proxy)
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
