# Production environment template for FocusFlow
# Copy to infra/docker/.env.prod and fill with real values.
# Used by: infra/docker/compose.prod.yml
#
# NEVER commit the real .env.prod file!

# ── Domain ───────────────────────────────────────────────────────────
# Used by Caddy and Grafana for routing
DOMAIN=sparcarclabs.com

# ── Application ──────────────────────────────────────────────────────
ENV=prod
LOG_LEVEL=info
REQUEST_TIMEOUT_S=30
DB_LOG_QUERIES=false

# CORS: origins allowed to call the API directly (admin goes through nginx proxy)
CORS_ORIGINS=["https://admin.sparcarclabs.com"]

# ── Database (Supabase Postgres) ─────────────────────────────────────
# Direct connection (port 5432) or Pooler (port 6543)
DATABASE_URL=postgresql+asyncpg://user:password@db.xxx.supabase.co:6543/postgres
DB_POOL_SIZE=15
DB_MAX_OVERFLOW=15

# ── Supabase Auth (used by API + Admin panel) ────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ── Sync cursor HMAC signing ────────────────────────────────────────
CURSOR_SECRET=CHANGE_ME_TO_RANDOM_SECRET

# ── Redis (internal Docker network, no override needed) ──────────────
# REDIS_COORDINATION_HOST=redis-coordination
# REDIS_COORDINATION_PORT=6379
# REDIS_CACHE_HOST=redis-cache
# REDIS_CACHE_PORT=6379

# ── Agent (LLM) ─────────────────────────────────────────────────────
OPENROUTER_API_KEY=
AGENT_BASE_URL=https://openrouter.ai/api/v1
AGENT_MODEL=
AGENT_TOOL_TIMEOUT_S=60

# ── PostHog (admin analytics proxy) ────────────────────────────────
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# ── Grafana ──────────────────────────────────────────────────────────
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
