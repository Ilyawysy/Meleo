# Docker Compose environment template for API service.
# Copy to infra/docker/.env and fill with local values.
# Used by: infra/docker/compose.yml (service api, env_file: .env)

# Database
# Direct connection (port 5432) — each app connection = 1 Postgres connection
# DATABASE_URL=postgresql+asyncpg://user:password@db.xxx.supabase.co:5432/postgres
# Pooler connection (port 6543) — multiplexed via Supavisor, higher connection limits
# DATABASE_URL=postgresql+asyncpg://user:password@db.xxx.supabase.co:6543/postgres
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname
DB_POOL_SIZE=15
DB_MAX_OVERFLOW=15
DB_LOG_QUERIES=true

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Application
REQUEST_TIMEOUT_S=30

# Redis (inside Docker network, ports are internal 6379)
# These are set in compose.yml environment, no need to override here usually.
# REDIS_COORDINATION_HOST=redis-coordination
# REDIS_COORDINATION_PORT=6379
# REDIS_CACHE_HOST=redis-cache
# REDIS_CACHE_PORT=6379

# Agent (LLM)
OPENROUTER_API_KEY=
AGENT_BASE_URL=https://openrouter.ai/api/v1
AGENT_MODEL=
AGENT_TOOL_TIMEOUT_S=60

# Load testing (bypass rate limits, dev only)
# LOADTEST_MODE=true
