{
    "title": "Errors Dashboard",
    "tags": ["errors", "monitoring"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "title": "Error Rate by Service",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "sum(rate({level=\"error\"}[1m])) by (service)",
            "refId": "A",
            "legendFormat": "{{service}}"
          }
        ],
        "xaxis": {"mode": "time"},
        "yaxes": [
          {"format": "short", "label": "errors/s"},
          {"format": "short"}
        ]
      },
      {
        "id": 2,
        "title": "Error Distribution",
        "type": "piechart",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "sum(count_over_time({level=\"error\"}[5m])) by (service)",
            "refId": "A",
            "legendFormat": "{{service}}"
          }
        ]
      },
      {
        "id": 3,
        "title": "Top Error Messages",
        "type": "table",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "topk(10, sum(count_over_time({level=\"error\"}[5m])) by (message))",
            "refId": "A",
            "format": "table"
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {
                "Time": true
              },
              "indexByName": {},
              "renameByName": {
                "Value": "Count",
                "message": "Error Message"
              }
            }
          }
        ]
      },
      {
        "id": 4,
        "title": "Error Logs",
        "type": "logs",
        "gridPos": {"h": 12, "w": 24, "x": 0, "y": 16},
        "targets": [
          {
            "expr": "{level=\"error\"}",
            "refId": "A"
          }
        ],
        "options": {
          "dedupStrategy": "none",
          "enableLogDetails": true,
          "prettifyLogMessage": false,
          "showCommonLabels": false,
          "showLabels": false,
          "showTime": true,
          "sortOrder": "Descending",
          "wrapLogMessage": false
        }
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
    }
}

