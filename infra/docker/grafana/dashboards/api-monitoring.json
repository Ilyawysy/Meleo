{
    "title": "API Monitoring",
    "tags": ["api", "monitoring"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 2,
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "title": "API Requests Rate",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "sum(rate({service=\"api\"}[1m]))",
            "refId": "A",
            "legendFormat": "Requests/sec"
          }
        ],
        "xaxis": {"mode": "time"},
        "yaxes": [
          {"format": "short", "label": "req/s"},
          {"format": "short"}
        ]
      },
      {
        "id": 2,
        "title": "API Errors",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "sum(rate({service=\"api\", level=\"error\"}[1m]))",
            "refId": "A",
            "legendFormat": "Errors/sec"
          }
        ],
        "xaxis": {"mode": "time"},
        "yaxes": [
          {"format": "short", "label": "errors/s"},
          {"format": "short"}
        ]
      },
      {
        "id": 3,
        "title": "Logs by Level (API)",
        "type": "piechart",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "sum(count_over_time({service=\"api\"}[5m])) by (level)",
            "refId": "A",
            "legendFormat": "{{level}}"
          }
        ]
      },
      {
        "id": 4,
        "title": "Request Completion Events",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "sum(rate({service=\"api\"} |= \"request_completed\"[1m]))",
            "refId": "A",
            "legendFormat": "Completed/sec"
          }
        ],
        "xaxis": {"mode": "time"},
        "yaxes": [
          {"format": "short"},
          {"format": "short"}
        ]
      },
      {
        "id": 6,
        "title": "Latency p50 by Endpoint",
        "type": "timeseries",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "gridPos": {"h": 10, "w": 24, "x": 0, "y": 16},
        "targets": [
          {
            "expr": "histogram_quantile(0.5, sum(rate(http_request_duration_seconds_bucket{route!=\"__unmatched__\",route!=\"/metrics\",route!=\"/health\",route!=\"/\"}[5m])) by (le, method, route))",
            "refId": "A",
            "legendFormat": "{{method}} {{route}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 10,
              "pointSize": 5,
              "showPoints": "auto"
            }
          }
        },
        "options": {
          "tooltip": {"mode": "multi", "sort": "desc"},
          "legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "max"]}
        }
      },
      {
        "id": 7,
        "title": "Latency p95 by Endpoint",
        "type": "timeseries",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "gridPos": {"h": 10, "w": 24, "x": 0, "y": 26},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{route!=\"__unmatched__\",route!=\"/metrics\",route!=\"/health\",route!=\"/\"}[5m])) by (le, method, route))",
            "refId": "A",
            "legendFormat": "{{method}} {{route}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 10,
              "pointSize": 5,
              "showPoints": "auto"
            }
          }
        },
        "options": {
          "tooltip": {"mode": "multi", "sort": "desc"},
          "legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "max"]}
        }
      },
      {
        "id": 8,
        "title": "Latency p99 by Endpoint",
        "type": "timeseries",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "gridPos": {"h": 10, "w": 24, "x": 0, "y": 36},
        "targets": [
          {
            "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{route!=\"__unmatched__\",route!=\"/metrics\",route!=\"/health\",route!=\"/\"}[5m])) by (le, method, route))",
            "refId": "A",
            "legendFormat": "{{method}} {{route}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 10,
              "pointSize": 5,
              "showPoints": "auto"
            }
          }
        },
        "options": {
          "tooltip": {"mode": "multi", "sort": "desc"},
          "legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "max"]}
        }
      },
      {
        "id": 9,
        "title": "Latency Summary Table (p50 / p95 / p99)",
        "type": "table",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "gridPos": {"h": 12, "w": 24, "x": 0, "y": 46},
        "targets": [
          {
            "expr": "histogram_quantile(0.5, sum(rate(http_request_duration_seconds_bucket{route!=\"__unmatched__\",route!=\"/metrics\",route!=\"/health\",route!=\"/\"}[5m])) by (le, method, route))",
            "refId": "p50",
            "legendFormat": "{{method}} {{route}}",
            "format": "table",
            "instant": true
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{route!=\"__unmatched__\",route!=\"/metrics\",route!=\"/health\",route!=\"/\"}[5m])) by (le, method, route))",
            "refId": "p95",
            "legendFormat": "{{method}} {{route}}",
            "format": "table",
            "instant": true
          },
          {
            "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{route!=\"__unmatched__\",route!=\"/metrics\",route!=\"/health\",route!=\"/\"}[5m])) by (le, method, route))",
            "refId": "p99",
            "legendFormat": "{{method}} {{route}}",
            "format": "table",
            "instant": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "decimals": 4
          },
          "overrides": [
            {
              "matcher": {"id": "byName", "options": "method"},
              "properties": [{"id": "custom.width", "value": 80}]
            },
            {
              "matcher": {"id": "byName", "options": "route"},
              "properties": [{"id": "custom.width", "value": 300}]
            }
          ]
        },
        "transformations": [
          {
            "id": "merge",
            "options": {}
          },
          {
            "id": "organize",
            "options": {
              "excludeByName": {"Time": true, "le": true, "__name__": true, "instance": true, "job": true},
              "renameByName": {
                "Value #p50": "p50 (s)",
                "Value #p95": "p95 (s)",
                "Value #p99": "p99 (s)"
              }
            }
          },
          {
            "id": "sortBy",
            "options": {"fields": [{"name": "p99 (s)", "desc": true}]}
          }
        ],
        "options": {
          "showHeader": true,
          "sortBy": [{"displayName": "p99 (s)", "desc": true}]
        }
      },
      {
        "id": 10,
        "title": "DB Query Latency p50 / p95 by Table",
        "type": "timeseries",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "gridPos": {"h": 10, "w": 24, "x": 0, "y": 58},
        "targets": [
          {
            "expr": "histogram_quantile(0.5, sum(rate(db_query_duration_seconds_bucket{entity!=\"unknown\"}[5m])) by (le, entity))",
            "refId": "p50",
            "legendFormat": "p50 {{entity}}"
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(db_query_duration_seconds_bucket{entity!=\"unknown\"}[5m])) by (le, entity))",
            "refId": "p95",
            "legendFormat": "p95 {{entity}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 10,
              "pointSize": 5,
              "showPoints": "auto"
            }
          }
        },
        "options": {
          "tooltip": {"mode": "multi", "sort": "desc"},
          "legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "max"]}
        }
      },
      {
        "id": 11,
        "title": "DB Queries Rate by Operation",
        "type": "timeseries",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "gridPos": {"h": 10, "w": 12, "x": 0, "y": 68},
        "targets": [
          {
            "expr": "sum(rate(db_queries_total[5m])) by (op)",
            "refId": "A",
            "legendFormat": "{{op}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "qps",
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 20,
              "stacking": {"mode": "normal"},
              "pointSize": 5,
              "showPoints": "auto"
            }
          }
        },
        "options": {
          "tooltip": {"mode": "multi", "sort": "desc"},
          "legend": {"displayMode": "list", "placement": "bottom"}
        }
      },
      {
        "id": 12,
        "title": "DB Queries Rate by Table",
        "type": "timeseries",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "gridPos": {"h": 10, "w": 12, "x": 12, "y": 68},
        "targets": [
          {
            "expr": "sum(rate(db_queries_total{entity!=\"unknown\"}[5m])) by (entity)",
            "refId": "A",
            "legendFormat": "{{entity}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "qps",
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 20,
              "stacking": {"mode": "normal"},
              "pointSize": 5,
              "showPoints": "auto"
            }
          }
        },
        "options": {
          "tooltip": {"mode": "multi", "sort": "desc"},
          "legend": {"displayMode": "list", "placement": "bottom"}
        }
      },
      {
        "id": 13,
        "title": "DB Query Latency Summary (p50 / p95 / p99 by Table)",
        "type": "table",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "gridPos": {"h": 12, "w": 24, "x": 0, "y": 78},
        "targets": [
          {
            "expr": "histogram_quantile(0.5, sum(rate(db_query_duration_seconds_bucket{entity!=\"unknown\"}[5m])) by (le, op, entity))",
            "refId": "p50",
            "legendFormat": "{{op}} {{entity}}",
            "format": "table",
            "instant": true
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(db_query_duration_seconds_bucket{entity!=\"unknown\"}[5m])) by (le, op, entity))",
            "refId": "p95",
            "legendFormat": "{{op}} {{entity}}",
            "format": "table",
            "instant": true
          },
          {
            "expr": "histogram_quantile(0.99, sum(rate(db_query_duration_seconds_bucket{entity!=\"unknown\"}[5m])) by (le, op, entity))",
            "refId": "p99",
            "legendFormat": "{{op}} {{entity}}",
            "format": "table",
            "instant": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "decimals": 4
          },
          "overrides": [
            {
              "matcher": {"id": "byName", "options": "op"},
              "properties": [{"id": "custom.width", "value": 80}]
            },
            {
              "matcher": {"id": "byName", "options": "entity"},
              "properties": [{"id": "custom.width", "value": 250}]
            }
          ]
        },
        "transformations": [
          {
            "id": "merge",
            "options": {}
          },
          {
            "id": "organize",
            "options": {
              "excludeByName": {"Time": true, "le": true, "__name__": true, "instance": true, "job": true},
              "renameByName": {
                "Value #p50": "p50 (s)",
                "Value #p95": "p95 (s)",
                "Value #p99": "p99 (s)"
              }
            }
          },
          {
            "id": "sortBy",
            "options": {"fields": [{"name": "p99 (s)", "desc": true}]}
          }
        ],
        "options": {
          "showHeader": true,
          "sortBy": [{"displayName": "p99 (s)", "desc": true}]
        }
      },
      {
        "id": 14,
        "title": "DB Query Duration (individual, requires DB_LOG_QUERIES=true)",
        "type": "timeseries",
        "datasource": {"type": "loki", "uid": "loki"},
        "gridPos": {"h": 10, "w": 24, "x": 0, "y": 90},
        "targets": [
          {
            "expr": "max_over_time({service=\"api\"} |= \"db_query_completed\" | regexp `duration_ms=(?P<duration_ms>[0-9.]+)` | regexp `op=(?P<op>[a-z]+)` | regexp `entity=(?P<entity>[a-z_]+)` | unwrap duration_ms [15s]) by (entity, op)",
            "refId": "A",
            "legendFormat": "{{op}} {{entity}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "custom": {
              "drawStyle": "points",
              "pointSize": 8,
              "showPoints": "always",
              "fillOpacity": 0,
              "lineWidth": 0
            }
          }
        },
        "options": {
          "tooltip": {"mode": "multi", "sort": "desc"},
          "legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "max", "lastNotNull"]}
        }
      },
      {
        "id": 15,
        "title": "DB Query Log (individual, requires DB_LOG_QUERIES=true)",
        "type": "logs",
        "datasource": {"type": "loki", "uid": "loki"},
        "gridPos": {"h": 10, "w": 24, "x": 0, "y": 100},
        "targets": [
          {
            "expr": "{service=\"api\"} |= \"db_query_completed\"",
            "refId": "A"
          }
        ],
        "options": {
          "dedupStrategy": "none",
          "enableLogDetails": true,
          "prettifyLogMessage": false,
          "showCommonLabels": false,
          "showLabels": false,
          "showTime": true,
          "sortOrder": "Descending",
          "wrapLogMessage": false
        }
      },
      {
        "id": 5,
        "title": "API Logs",
        "type": "logs",
        "gridPos": {"h": 12, "w": 24, "x": 0, "y": 110},
        "targets": [
          {
            "expr": "{service=\"api\"}",
            "refId": "A"
          }
        ],
        "options": {
          "dedupStrategy": "none",
          "enableLogDetails": true,
          "prettifyLogMessage": false,
          "showCommonLabels": false,
          "showLabels": false,
          "showTime": true,
          "sortOrder": "Descending",
          "wrapLogMessage": false
        }
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
    }
}
